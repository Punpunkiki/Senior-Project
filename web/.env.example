# Build-time settings for the website. Copy to .env.local before `npm run build`.
# NEXT_PUBLIC_* values are baked into the static output and are visible to
# anyone — never put a secret here.

# LINE Official Account id for the "add friend" button, e.g. @123abcde
NEXT_PUBLIC_LINE_ID=

# LIFF app id, used by /result to identify the viewer.
NEXT_PUBLIC_LIFF_ID=

# Where the API lives. Leave EMPTY when FastAPI serves this site from the same
# origin (the default single-container setup) so requests stay relative.
# Set to e.g. https://api.example.com only if the site is hosted separately.
NEXT_PUBLIC_API_BASE=
