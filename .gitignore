# data (large, downloaded separately from Mendeley)
/data/
/data_ood/
*.zip

# outputs: weights / figures / logs (regenerated by running the pipeline)
# (outputs/eda and other subdirs are created at runtime by ensure_dir)
/outputs/**
!/outputs/.gitkeep

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/
.env

# LINE OA service runtime state (farmer photos + local DB -- never committed)
/uploads/
*.db
*.sqlite3

# os / editor
.DS_Store
*.swp

# web front-end build artifacts
/web/node_modules/
/web/.next/
/web/out/
/web/next-env.d.ts
.env.local
