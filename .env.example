# Copy to .env and fill in real values. Never commit .env.

# --- LINE Messaging API (LINE Developers Console > your channel) -----------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LIFF (LINE Developers Console > LIFF tab) ------------------------------
LIFF_ID=

# --- Model serving -----------------------------------------------------------
# Path to the ML pipeline's config.yaml (classes/transforms/architectures).
CONFIG_YAML_PATH=./config.yaml
# Which trained backbone to serve. Must match a name in config.yaml -> models[]
# and have outputs/<MODEL_NAME>/best.pt present.
MODEL_NAME=efficientnet_b0

# --- Confidence tiers (product decision, see app/diagnosis.py) -------------
CONFIDENCE_HIGH=0.75
CONFIDENCE_LOW=0.45

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///./durian_bot.db
UPLOAD_DIR=./uploads
IMAGE_RETENTION_DAYS=30
MAX_IMAGE_MB=10

# --- Public URLs (fill in once deployed; see line-assets/HANDOFF.md) -------
BASE_URL=https://your-deployed-domain.example.com
WEB_BASE_URL=https://your-web-domain.example.com

# --- Human fallback ------------------------------------------------------------
ADMIN_CONTACT_TEXT=ติดต่อเจ้าหน้าที่เกษตรได้ที่เบอร์ 02-XXX-XXXX (จันทร์-ศุกร์ 08:30-16:30)

PORT=8000
